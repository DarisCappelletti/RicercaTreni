<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ricerca Treni</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,200..900&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar narice">
            <div class="container">
                <a class="narice-marchio" asp-area="" asp-page="/Index">Ricerca Treni</a>
                <div class="narice-voci">
                    <a class="nav-link" asp-area="" asp-page="/Index">Cerca</a>
                    <a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-interno">
            <span>&copy; 2026 Ricerca Treni di Daris Cappelletti</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
        <div class="container">
            <small>Progetto didattico sulle API non ufficiali di lefrecce: non è collegato al servizio ufficiale di Trenitalia.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>