@page
@model ErrorModel
@{
    ViewData["Title"] = "Errore";
}

<div class="pagina-semplice">
    <h1>Errore</h1>
    <p>Si è verificato un errore durante l'elaborazione della richiesta.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <p>La modalità Development mostra informazioni dettagliate sull'errore: è da attivare solo in locale, non sul sito pubblicato.</p>
</div>