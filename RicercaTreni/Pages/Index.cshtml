@page
@model IndexModel
@using RicercaTreni.Models
@using RicercaTreni.Services
@using System.Globalization
@{
    ViewData["Title"] = "Ricerca treni";
    var haTratta = !string.IsNullOrWhiteSpace(Model.Form.StazionePartenza)
        && !string.IsNullOrWhiteSpace(Model.Form.StazioneArrivo);
}

@functions
{
    private static readonly CultureInfo Italiana = CultureInfo.GetCultureInfo("it-IT");

    static string Prezzo(Models.Prezzo? prezzo) =>
        prezzo?.amount is double valore ? valore.ToString("0.00", Italiana) + " €" : "non disponibile";

    static string Ora(DateTime momento) => momento.ToString("HH:mm");

    static string Giorno(DateTime momento) => momento.ToString("dd/MM");

    static string Orario(DateTime momento) => momento.ToString("dd/MM/yyyy HH:mm");

    /// <summary>Le categorie dei treni della soluzione (FR 9500, REG 10234...).</summary>
    static List<string> EtichetteTreni(Soluzione s)
    {
        if (s.solution?.trains is { Count: > 0 })
            return s.solution.trains
                .Where(t => t is not null)
                .Select(t => string.Join(" ", new[] { t.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
                .Where(etichetta => etichetta.Length > 0)
                .ToList();

        return (s.grids ?? [])
            .SelectMany(g => g.summaries ?? [])
            .Select(r => r.trainInfo)
            .Where(t => t is not null)
            .Select(t => string.Join(" ", new[] { t!.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
            .Where(etichetta => etichetta.Length > 0)
            .Distinct()
            .ToList();
    }
}

<div class="tabellone">
    <div class="container container-treno">
        <div class="tabellone-tratta">
            @if (haTratta)
            {
                <span class="tabellone-capo">
                    <span class="tabellone-ruolo">Da</span>
                    @Model.Form.StazionePartenza
                </span>
                <span class="tabellone-verso" aria-hidden="true"></span>
                <span class="tabellone-capo">
                    <span class="tabellone-ruolo">A</span>
                    @Model.Form.StazioneArrivo
                </span>
            }
            else
            {
                <span>Nessuna stazione impostata</span>
            }
        </div>
    </div>
</div>

<div class="container container-treno">
    <form method="post" class="sportello" data-cerca>
        <div class="griglia-sportello">
            <div class="coppia-stazioni">
                <div class="campo">
                    <label class="campo-etichetta" for="Form_StazionePartenza">
                        Stazione di partenza <span class="campo-obbligo">*</span>
                    </label>
                    <input class="form-control inputStazioniDropdown" list="vociPartenza" id="Form_StazionePartenza"
                           asp-for="Form.StazionePartenza" placeholder="Scrivi la stazione desiderata..." autocomplete="off" />
                    <datalist id="vociPartenza"></datalist>
                </div>
                <div class="campo">
                    <label class="campo-etichetta" for="Form_StazioneArrivo">
                        Stazione di arrivo <span class="campo-obbligo">*</span>
                    </label>
                    <input class="form-control inputStazioniDropdown" list="vociArrivo" id="Form_StazioneArrivo"
                           asp-for="Form.StazioneArrivo" placeholder="Scrivi la stazione desiderata..." autocomplete="off" />
                    <datalist id="vociArrivo"></datalist>
                </div>
                <button type="button" class="tasto-scambia" title="Scambia le due stazioni" aria-label="Scambia partenza e arrivo">⇄</button>
            </div>

            <div class="campo">
                <label class="campo-etichetta" for="Form_Adulti">Adulti <span class="campo-obbligo">*</span></label>
                <input type="number" min="1" max="9" class="form-control" asp-for="Form.Adulti" />
            </div>
            <div class="campo">
                <label class="campo-etichetta" for="Form_Bambini">Bambini</label>
                <input type="number" min="0" max="9" class="form-control" asp-for="Form.Bambini" />
            </div>
            <div class="campo">
                <label class="campo-etichetta" for="Form_DataInizio">Data di inizio <span class="campo-obbligo">*</span></label>
                <input type="date" class="form-control" asp-for="Form.DataInizio" />
            </div>
            <div class="campo">
                <label class="campo-etichetta" for="Form_DataFine">Data di fine</label>
                <input type="date" class="form-control" asp-for="Form.DataFine" />
            </div>

            <div class="riga-aggiunte">
                <label class="chip"><input type="checkbox" data-data-rapida="0" /><span>Oggi</span></label>
                <label class="chip"><input type="checkbox" data-data-rapida="1" /><span>Domani</span></label>
            </div>

            <div class="riga-aggiunte">
                <label class="chip"><input asp-for="Form.SoloSuperEconomy" /><span>Solo Super Economy</span></label>
                <label class="chip"><input asp-for="Form.SoloFrecce" /><span>Solo Frecce</span></label>
                <label class="chip"><input asp-for="Form.SoloRegionali" /><span>Solo Regionali</span></label>
                <label class="chip"><input asp-for="Form.SoloDiretti" /><span>Solo diretti</span></label>
                <label class="chip chip-prezzo">
                    <span>Prezzo fino a</span>
                    <input type="number" step="0.01" min="0" class="form-control" asp-for="Form.PrezzoMassimo" />
                </label>
            </div>

            <button type="submit" class="tasto-cerca">
                <span class="cercando" aria-hidden="true"></span>Cerca treni
            </button>
        </div>
    </form>

    <details class="piehevole">
        <summary>Cosa puoi cercare</summary>
        <ul>
            <li>Le soluzioni di un giorno specifico, impostando la data di inizio</li>
            <li>Tutte le soluzioni di un intervallo di giorni, impostando anche la data di fine</li>
            <li>Solo le soluzioni con biglietti Super Economy, con treni ad alta velocità, regionali o diretti</li>
            <li>Solo le soluzioni sotto un tetto massimo di prezzo</li>
        </ul>
    </details>
</div>

<div class="container container-treno">
    @if (Model.Soluzioni.Count == 0 && Model.Messaggio is not null)
    {
        <div class="avviso avviso-fermo">@Model.Messaggio</div>
    }

    @if (Model.Soluzioni.Count > 0)
    {
        <div class="esito-titolo">
            <span class="esito-numero">@Model.Soluzioni.Count soluzioni</span>
            <span class="esito-nota">l'elenco segue l'orario di partenza</span>
        </div>

        <div class="elenco-treni">
            @for (var i = 0; i < Model.Soluzioni.Count; i++)
            {
                var s = Model.Soluzioni[i];
                <article class="treno">
                    <div class="treno-viaggio">
                        <div class="momento">
                            @if (s.solution is { } partenza)
                            {
                                <span class="momento-ora momento-via">@Ora(partenza.departureTime)</span>
                                <span class="momento-luogo"><span class="momento-giorno">@Giorno(partenza.departureTime)</span> @partenza.origin</span>
                            }
                        </div>
                        <div class="via"><span>@s.solution?.duration</span></div>
                        <div class="momento">
                            @if (s.solution is { } arrivo)
                            {
                                <span class="momento-ora">@Ora(arrivo.arrivalTime)</span>
                                <span class="momento-luogo"><span class="momento-giorno">@Giorno(arrivo.arrivalTime)</span> @arrivo.destination</span>
                            }
                        </div>
                    </div>
                    <div class="treno-acquisto">
                        <span class="prezzo">@Prezzo(s.solution?.price)</span>
                        @if (LefrecceClient.EOffertaSuperEconomy(s))
                        {
                            <span class="badge-super">Super Economy</span>
                        }
                        <button type="button" class="tasto-dettagli" data-bs-toggle="modal" data-bs-target="#modalDettaglio-@i">
                            Dettagli
                        </button>
                    </div>

                    @{
                        var etichette = EtichetteTreni(s);
                    }
                    @if (etichette.Count > 0)
                    {
                        <div class="formazione">
                            @foreach (var etichetta in etichette)
                            {
                                <span class="formazione-categoria">@etichetta</span>
                            }
                        </div>
                    }
                </article>
            }
        </div>

        @for (var i = 0; i < Model.Soluzioni.Count; i++)
        {
            var s = Model.Soluzioni[i];
            <div class="modal fade" id="modalDettaglio-@i" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title modale-titolo" id="titoloModale-@i">
                                @s.solution?.origin → @s.solution?.destination
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                        </div>
                        <div class="modal-body">
                            <h6 class="modale-sezione">Il viaggio</h6>
                            <div class="table-responsive">
                                <table class="table tabella-dettagli">
                                    <thead>
                                        <tr>
                                            <th>Treno</th>
                                            <th>Partenza</th>
                                            <th>Orario</th>
                                            <th>Arrivo</th>
                                            <th>Orario</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var griglia in s.grids ?? [])
                                        {
                                            @foreach (var riepilogo in griglia.summaries ?? [])
                                            {
                                                <tr>
                                                    <td>@riepilogo.name</td>
                                                    <td>@riepilogo.departureLocationName</td>
                                                    <td class="cella-ora">@Orario(riepilogo.departureTime)</td>
                                                    <td>@riepilogo.arrivalLocationName</td>
                                                    <td class="cella-ora">@Orario(riepilogo.arrivalTime)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <h6 class="modale-sezione">Offerte di acquisto</h6>
                            <div class="table-responsive">
                                <table class="table tabella-dettagli">
                                    <thead>
                                        <tr>
                                            <th>Nome</th>
                                            <th>Offerta</th>
                                            <th>Prezzo</th>
                                            <th>Disponibilità</th>
                                            <th>Descrizione</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var griglia in s.grids ?? [])
                                        {
                                            @foreach (var servizio in griglia.services ?? [])
                                            {
                                                @foreach (var offerta in servizio.offers ?? [])
                                                {
                                                    @if (offerta.availableAmount > 0)
                                                    {
                                                        <tr>
                                                            <td class="offerta-vendita">@offerta.serviceName</td>
                                                            <td>@offerta.name</td>
                                                            <td>@Prezzo(offerta.price)</td>
                                                            <td>@offerta.availableAmount</td>
                                                            <td>@offerta.description</td>
                                                        </tr>
                                                    }
                                                }
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>