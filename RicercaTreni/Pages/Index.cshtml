@page
@model IndexModel
@using RicercaTreni.Models
@using RicercaTreni.Services
@using System.Globalization
@{
    ViewData["Title"] = "Ricerca treni";
}

@functions
{
    private static readonly CultureInfo Italiana = CultureInfo.GetCultureInfo("it-IT");

    static string Prezzo(Models.Prezzo? prezzo) =>
        prezzo?.amount is double valore ? valore.ToString("0.00", Italiana) + " €" : "non disponibile";

    static string Ora(DateTime momento) => momento.ToString("HH:mm");

    static string Giorno(DateTime momento) => momento.ToString("dd/MM/yyyy");

    static string Orario(DateTime momento) => momento.ToString("dd/MM/yyyy HH:mm");

    /// <summary>Le categorie dei treni della soluzione (FR 9500, REG 10234...).</summary>
    static List<string> EtichetteTreni(Soluzione s)
    {
        if (s.solution?.trains is { Count: > 0 })
            return s.solution.trains
                .Where(t => t is not null)
                .Select(t => string.Join(" ", new[] { t.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
                .Where(etichetta => etichetta.Length > 0)
                .ToList();

        return (s.grids ?? [])
            .SelectMany(g => g.summaries ?? [])
            .Select(r => r.trainInfo)
            .Where(t => t is not null)
            .Select(t => string.Join(" ", new[] { t!.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
            .Where(etichetta => etichetta.Length > 0)
            .Distinct()
            .ToList();
    }
}

<h1 class="mt-4">Ricerca treni</h1>
<p class="text-secondary">
    Imposta stazioni, data e passeggeri: mostro tutte le soluzioni di viaggio con prezzi e offerte disponibili.
    Con la data di fine la ricerca copre tutto l'intervallo di giorni.
</p>

<form method="post" data-cerca class="card border card-ricerca mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label" for="Form_StazionePartenza">Stazione di partenza <span class="text-danger">*</span></label>
                <input class="form-control inputStazioniDropdown" list="vociPartenza" id="Form_StazionePartenza"
                       asp-for="Form.StazionePartenza" placeholder="Scrivi la stazione..." autocomplete="off" />
                <datalist id="vociPartenza"></datalist>
            </div>
            <div class="col-md-2 d-flex align-items-end justify-content-center">
                <button type="button" class="btn btn-outline-secondary btn-scambia"
                        title="Scambia le due stazioni" aria-label="Scambia partenza e arrivo">⇄</button>
            </div>
            <div class="col-md-5">
                <label class="form-label" for="Form_StazioneArrivo">Stazione di arrivo <span class="text-danger">*</span></label>
                <input class="form-control inputStazioniDropdown" list="vociArrivo" id="Form_StazioneArrivo"
                       asp-for="Form.StazioneArrivo" placeholder="Scrivi la stazione..." autocomplete="off" />
                <datalist id="vociArrivo"></datalist>
            </div>

            <div class="col-md-2 col-6">
                <label class="form-label" for="Form_Adulti">Adulti <span class="text-danger">*</span></label>
                <input type="number" min="1" max="9" class="form-control" asp-for="Form.Adulti" />
            </div>
            <div class="col-md-2 col-6">
                <label class="form-label" for="Form_Bambini">Bambini</label>
                <input type="number" min="0" max="9" class="form-control" asp-for="Form.Bambini" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="Form_DataInizio">Data di inizio <span class="text-danger">*</span></label>
                <input type="date" class="form-control" asp-for="Form.DataInizio" />
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-data-rapida" data-data-rapida="0">Oggi</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-data-rapida" data-data-rapida="1">Domani</button>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="Form_DataFine">Data di fine (facoltativa)</label>
                <input type="date" class="form-control" asp-for="Form.DataFine" />
            </div>

            <div class="col-12">
                <span class="form-label d-block fw-semibold">Filtri</span>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloSuperEconomy" />
                    <label class="form-check-label" for="Form_SoloSuperEconomy">Solo Super Economy</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloFrecce" />
                    <label class="form-check-label" for="Form_SoloFrecce">Solo Frecce</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloRegionali" />
                    <label class="form-check-label" for="Form_SoloRegionali">Solo regionali</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloDiretti" />
                    <label class="form-check-label" for="Form_SoloDiretti">Solo diretti</label>
                </div>
                <div class="form-check form-check-inline d-inline-flex align-items-center gap-2">
                    <label class="form-check-label" for="Form_PrezzoMassimo">Prezzo fino a</label>
                    <input type="number" step="0.01" min="0" class="form-control form-control-sm d-inline-block" style="width: 5.5rem;" asp-for="Form.PrezzoMassimo" />
                    <span>€</span>
                </div>
            </div>

            <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                <button type="submit" class="btn btn-freccia px-4 fw-semibold">
                    <span class="cercando" aria-hidden="true"></span>Cerca treni
                </button>
                <span class="text-secondary small">Almeno un adulto; intervallo massimo: 14 giorni.</span>
            </div>
        </div>
    </div>
</form>

@if (Model.Soluzioni.Count == 0 && Model.Messaggio is not null)
{
    <div class="alert alert-secondary card-ricerca" role="alert">@Model.Messaggio</div>
}

@if (Model.Soluzioni.Count > 0)
{
    <div class="card-ricerca">
        <h2 class="h5 mt-3 mb-2">@Model.Soluzioni.Count soluzioni trovate</h2>

        <div class="table-responsive bg-white border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Partenza</th>
                        <th scope="col">Arrivo</th>
                        <th scope="col">Durata</th>
                        <th scope="col">Treni</th>
                        <th scope="col">Prezzo da</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Soluzioni.Count; i++)
                    {
                        var s = Model.Soluzioni[i];
                        <tr>
                            <td>
                                @if (s.solution is { } partenza)
                                {
                                    <span class="ora-grande d-block">@Ora(partenza.departureTime)</span>
                                    <span class="ora-luogo d-block">@Giorno(partenza.departureTime) — @partenza.origin</span>
                                }
                            </td>
                            <td>
                                @if (s.solution is { } arrivo)
                                {
                                    <span class="ora-grande d-block">@Ora(arrivo.arrivalTime)</span>
                                    <span class="ora-luogo d-block">@Giorno(arrivo.arrivalTime) — @arrivo.destination</span>
                                }
                            </td>
                            <td class="text-nowrap">@s.solution?.duration</td>
                            <td>
                                @{
                                    var etichette = EtichetteTreni(s);
                                }
                                @if (etichette.Count > 0)
                                {
                                    @foreach (var etichetta in etichette)
                                    {
                                        <span class="badge border text-secondary fw-normal">@etichetta</span>
                                    }
                                }
                            </td>
                            <td class="text-nowrap">
                                <span class="prezzo-grande">@Prezzo(s.solution?.price)</span>
                                @if (LefrecceClient.EOffertaSuperEconomy(s))
                                {
                                    <span class="badge text-bg-success">Super Economy</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalDettaglio-@i">
                                    Dettagli
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @for (var i = 0; i < Model.Soluzioni.Count; i++)
    {
        var s = Model.Soluzioni[i];
        <div class="modal fade" id="modalDettaglio-@i" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titoloModale-@i">
                            @s.solution?.origin → @s.solution?.destination
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                    </div>
                    <div class="modal-body">
                        <h6>Il viaggio</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Treno</th>
                                        <th>Partenza</th>
                                        <th>Orario</th>
                                        <th>Arrivo</th>
                                        <th>Orario</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var riepilogo in griglia.summaries ?? [])
                                        {
                                            <tr>
                                                <td>@riepilogo.name</td>
                                                <td>@riepilogo.departureLocationName</td>
                                                <td class="text-nowrap">@Orario(riepilogo.departureTime)</td>
                                                <td>@riepilogo.arrivalLocationName</td>
                                                <td class="text-nowrap">@Orario(riepilogo.arrivalTime)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h6 class="mt-3">Offerte di acquisto</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Offerta</th>
                                        <th>Prezzo</th>
                                        <th>Disponibilità</th>
                                        <th>Descrizione</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var servizio in griglia.services ?? [])
                                        {
                                            @foreach (var offerta in servizio.offers ?? [])
                                            {
                                                @if (offerta.availableAmount > 0)
                                                {
                                                    <tr>
                                                        <td>@offerta.serviceName</td>
                                                        <td>@offerta.name</td>
                                                        <td class="text-nowrap">@Prezzo(offerta.price)</td>
                                                        <td>@offerta.availableAmount</td>
                                                        <td>@offerta.description</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                    </div>
                </div>
            </div>
        </div>
    }
}