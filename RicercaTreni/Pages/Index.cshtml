@page
@model IndexModel
@using RicercaTreni.Models
@using RicercaTreni.Services
@using System.Globalization
@{
    ViewData["Title"] = "Ricerca treni";
}

@functions
{
    private static readonly CultureInfo Italiana = CultureInfo.GetCultureInfo("it-IT");

    static string Prezzo(Models.Prezzo? prezzo) =>
        prezzo?.amount is double valore ? valore.ToString("0.00", Italiana) + " €" : "non disponibile";

    static string Ora(DateTime momento) => momento.ToString("HH:mm");

    static string Giorno(DateTime momento) => momento.ToString("dd/MM/yyyy");

    static string Orario(DateTime momento) => momento.ToString("dd/MM/yyyy HH:mm");

    /// <summary>Le categorie dei treni della soluzione (FR 9500, REG 10234...).</summary>
    static List<string> EtichetteTreni(Soluzione s)
    {
        if (s.solution?.trains is { Count: > 0 })
            return s.solution.trains
                .Where(t => t is not null)
                .Select(t => string.Join(" ", new[] { t.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
                .Where(etichetta => etichetta.Length > 0)
                .ToList();

        return (s.grids ?? [])
            .SelectMany(g => g.summaries ?? [])
            .Select(r => r.trainInfo)
            .Where(t => t is not null)
            .Select(t => string.Join(" ", new[] { t!.acronym, t.name }.Where(v => !string.IsNullOrWhiteSpace(v))))
            .Where(etichetta => etichetta.Length > 0)
            .Distinct()
            .ToList();
    }
}

<div class="pagina">
    <div class="introduzione">
        <h1>Ricerca treni</h1>
        <p>
            Imposta stazioni, data e passeggeri: mostro tutte le soluzioni di viaggio con prezzi e offerte disponibili.
            Con la data di fine la ricerca copre tutto l'intervallo di giorni.
        </p>
    </div>

    <form method="post" data-cerca class="carta-ricerca">
        <div class="riga-stazioni">
            <div>
                <label class="etichetta" for="Form_StazionePartenza">Stazione di partenza</label>
                <input class="campo inputStazioniDropdown" list="vociPartenza" id="Form_StazionePartenza"
                       asp-for="Form.StazionePartenza" placeholder="Scrivi la stazione..." autocomplete="off" />
                <datalist id="vociPartenza"></datalist>
            </div>
            <div class="tratta">
                <button type="button" class="btn-scambia"
                        title="Scambia le due stazioni" aria-label="Scambia partenza e arrivo">⇄</button>
            </div>
            <div>
                <label class="etichetta" for="Form_StazioneArrivo">Stazione di arrivo</label>
                <input class="campo inputStazioniDropdown" list="vociArrivo" id="Form_StazioneArrivo"
                       asp-for="Form.StazioneArrivo" placeholder="Scrivi la stazione..." autocomplete="off" />
                <datalist id="vociArrivo"></datalist>
            </div>
        </div>

        <div class="row g-3 mt-0 mt-md-2">
            <div class="col-6 col-md-2">
                <label class="etichetta" for="Form_Adulti">Adulti</label>
                <input type="number" min="1" max="9" class="campo" asp-for="Form.Adulti" />
            </div>
            <div class="col-6 col-md-2">
                <label class="etichetta" for="Form_Bambini">Bambini</label>
                <input type="number" min="0" max="9" class="campo" asp-for="Form.Bambini" />
            </div>
            <div class="col-12 col-md-4">
                <label class="etichetta" for="Form_DataInizio">Data di inizio</label>
                <input type="date" class="campo" asp-for="Form.DataInizio" />
                <div class="d-flex gap-1 mt-2">
                    <button type="button" class="chipdata btn btn-sm" data-data-rapida="0">Oggi</button>
                    <button type="button" class="chipdata btn btn-sm" data-data-rapida="1">Domani</button>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <label class="etichetta" for="Form_DataFine">Data di fine (facoltativa)</label>
                <input type="date" class="campo" asp-for="Form.DataFine" />
            </div>
        </div>

        <div class="filtri">
            <span class="etichetta">Filtri</span>
            <div class="gruppo-pastiglie">
                <div class="pastiglia">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloSuperEconomy" />
                    <label class="pastiglia-testo" for="Form_SoloSuperEconomy">Solo Super Economy</label>
                </div>
                <div class="pastiglia">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloFrecce" />
                    <label class="pastiglia-testo" for="Form_SoloFrecce">Solo Frecce</label>
                </div>
                <div class="pastiglia">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloRegionali" />
                    <label class="pastiglia-testo" for="Form_SoloRegionali">Solo regionali</label>
                </div>
                <div class="pastiglia">
                    <input class="form-check-input" type="checkbox" asp-for="Form.SoloDiretti" />
                    <label class="pastiglia-testo" for="Form_SoloDiretti">Solo diretti</label>
                </div>
                <div class="pastiglia">
                    <label class="pastiglia-testo" for="Form_PrezzoMassimo">
                        Prezzo fino a
                        <input type="number" step="0.01" min="0" class="campo-sera" asp-for="Form.PrezzoMassimo" />
                        <span>€</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="azione-ricerca">
            <button type="submit" class="btn btn-freccia">
                <span class="cercando" aria-hidden="true"></span>Cerca treni
            </button>
            <span class="nota">Almeno un adulto; intervallo massimo: 14 giorni.</span>
        </div>
    </form>
</div>

@if (Model.Soluzioni.Count == 0 && Model.Messaggio is not null)
{
    <div class="pagina">
        <div class="avviso" role="alert">@Model.Messaggio</div>
    </div>
}

@if (Model.Soluzioni.Count > 0)
{
    <div class="pagina risultati">
        <div class="risultati-testa">
            <h2>@Model.Soluzioni.Count soluzioni trovate</h2>
            <p>Orari e prezzi degli itinerari. Con "Dettagli" le offerte di acquisto di ogni soluzione.</p>
        </div>

        <div class="tabella-soluzioni table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Partenza</th>
                        <th scope="col">Arrivo</th>
                        <th scope="col">Durata</th>
                        <th scope="col">Treni</th>
                        <th scope="col">Prezzo da</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Soluzioni.Count; i++)
                    {
                        var s = Model.Soluzioni[i];
                        <tr>
                            <td>
                                @if (s.solution is { } partenza)
                                {
                                    <span class="ora-grande d-block">@Ora(partenza.departureTime)</span>
                                    <span class="ora-luogo d-block">@Giorno(partenza.departureTime) — @partenza.origin</span>
                                }
                            </td>
                            <td>
                                @if (s.solution is { } arrivo)
                                {
                                    <span class="ora-grande d-block">@Ora(arrivo.arrivalTime)</span>
                                    <span class="ora-luogo d-block">@Giorno(arrivo.arrivalTime) — @arrivo.destination</span>
                                }
                            </td>
                            <td class="text-nowrap">@s.solution?.duration</td>
                            <td>
                                @{
                                    var etichette = EtichetteTreni(s);
                                }
                                @if (etichette.Count > 0)
                                {
                                    @foreach (var etichetta in etichette)
                                    {
                                        <span class="chip">@etichetta</span>
                                    }
                                }
                            </td>
                            <td class="text-nowrap">
                                <span class="prezzo-grande @(s.solution?.price is null ? "prezzo-vuoto" : "")">@Prezzo(s.solution?.price)</span>
                                @if (LefrecceClient.EOffertaSuperEconomy(s))
                                {
                                    <span class="badge-super">Super Economy</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-dettaglio" data-bs-toggle="modal" data-bs-target="#modalDettaglio-@i">
                                    Dettagli
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @for (var i = 0; i < Model.Soluzioni.Count; i++)
    {
        var s = Model.Soluzioni[i];
        <div class="modal fade" id="modalDettaglio-@i" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="titoloModale-@i">
                            @s.solution?.origin → @s.solution?.destination
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                    </div>
                    <div class="modal-body">
                        <h6>Il viaggio</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Treno</th>
                                        <th>Partenza</th>
                                        <th>Orario</th>
                                        <th>Arrivo</th>
                                        <th>Orario</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var riepilogo in griglia.summaries ?? [])
                                        {
                                            <tr>
                                                <td>@riepilogo.name</td>
                                                <td>@riepilogo.departureLocationName</td>
                                                <td class="text-nowrap">@Orario(riepilogo.departureTime)</td>
                                                <td>@riepilogo.arrivalLocationName</td>
                                                <td class="text-nowrap">@Orario(riepilogo.arrivalTime)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h6 class="mt-3">Offerte di acquisto</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Nome</th>
                                        <th>Offerta</th>
                                        <th>Prezzo</th>
                                        <th>Disponibilità</th>
                                        <th>Descrizione</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var servizio in griglia.services ?? [])
                                        {
                                            @foreach (var offerta in servizio.offers ?? [])
                                            {
                                                @if (offerta.availableAmount > 0)
                                                {
                                                    <tr>
                                                        <td>@offerta.serviceName</td>
                                                        <td>@offerta.name</td>
                                                        <td class="text-nowrap">@Prezzo(offerta.price)</td>
                                                        <td>@offerta.availableAmount</td>
                                                        <td>@offerta.description</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                    </div>
                </div>
            </div>
        </div>
    }
}