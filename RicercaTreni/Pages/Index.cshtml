@page
@model IndexModel
@using RicercaTreni.Models
@{
    ViewData["Title"] = "Ricerca treni";
}

@functions
{
    static string Prezzo(Prezzo? prezzo) =>
        prezzo?.amount is double valore ? $"{valore:0.##} {prezzo.currency}" : "-";

    static string Orario(DateTime momento) => momento.ToString("dd/MM/yyyy HH:mm");
}

<h1>Ricerca treni</h1>
<p class="text-muted">
    Ricerca delle soluzioni di viaggio dei treni Trenitalia per una data o un intervallo di date, con prezzi e offerte disponibili.
    Progetto didattico basato sulle API non ufficiali di lefrecce: non è collegato al servizio ufficiale di Trenitalia.
</p>

<div class="accordion mb-3" id="accordionDettagli">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDettagli"
                    aria-expanded="false" aria-controls="collapseDettagli">
                Funzionalità disponibili
            </button>
        </h2>
        <div id="collapseDettagli" class="accordion-collapse collapse" data-bs-parent="#accordionDettagli">
            <div class="accordion-body">
                <div style="font-size: small;">È possibile effettuare le seguenti operazioni:</div>
                <ul style="font-size: small;">
                    <li>Ricercare le soluzioni di un giorno specifico impostando una data di inizio</li>
                    <li>Ricercare tutte le soluzioni in un intervallo di giorni impostando data di inizio e di fine</li>
                    <li>Ricercare le soluzioni dove sono presenti biglietti "Super Economy"</li>
                    <li>Ricercare le soluzioni con treni ad alta velocità (Frecce)</li>
                    <li>Ricercare le soluzioni con treni regionali</li>
                    <li>Ricercare le soluzioni con treni diretti</li>
                    <li>Ricercare le soluzioni sotto un tetto massimo di prezzo</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<form method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="Form_StazionePartenza" class="form-label"><strong>Stazione di partenza <span class="text-danger">*</span></strong></label>
            <input class="form-control inputStazioniDropdown" list="vociPartenza" id="Form_StazionePartenza"
                   asp-for="Form.StazionePartenza" placeholder="Scrivi per ricercare la stazione desiderata..." autocomplete="off" />
            <datalist id="vociPartenza"></datalist>
        </div>
        <div class="col-md-6 mb-3">
            <label for="Form_StazioneArrivo" class="form-label"><strong>Stazione di arrivo <span class="text-danger">*</span></strong></label>
            <input class="form-control inputStazioniDropdown" list="vociArrivo" id="Form_StazioneArrivo"
                   asp-for="Form.StazioneArrivo" placeholder="Scrivi per ricercare la stazione desiderata..." autocomplete="off" />
            <datalist id="vociArrivo"></datalist>
        </div>
    </div>
    <div class="row">
        <div class="col-md-2 mb-3">
            <label for="Form_Adulti" class="form-label"><strong>Numero adulti <span class="text-danger">*</span></strong></label>
            <input type="number" min="1" class="form-control" asp-for="Form.Adulti" />
        </div>
        <div class="col-md-2 mb-3">
            <label for="Form_Bambini" class="form-label"><strong>Numero bambini</strong></label>
            <input type="number" min="0" class="form-control" asp-for="Form.Bambini" />
        </div>
        <div class="col-md-4 mb-3">
            <label for="Form_DataInizio" class="form-label">
                <strong>Data di inizio <span class="text-danger">*</span></strong>
            </label>
            <input type="date" class="form-control" asp-for="Form.DataInizio" />
        </div>
        <div class="col-md-4 mb-3">
            <label for="Form_DataFine" class="form-label">
                <strong>Data di fine</strong>
            </label>
            <input type="date" class="form-control" asp-for="Form.DataFine" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-2 mb-3">
            <label for="Form_SoloSuperEconomy" class="form-label"><strong>Solo Super Economy</strong></label>
            <input type="checkbox" class="form-check-input d-block" asp-for="Form.SoloSuperEconomy" />
        </div>
        <div class="col-md-2 mb-3">
            <label for="Form_SoloFrecce" class="form-label"><strong>Solo Frecce</strong></label>
            <input type="checkbox" class="form-check-input d-block" asp-for="Form.SoloFrecce" />
        </div>
        <div class="col-md-2 mb-3">
            <label for="Form_SoloRegionali" class="form-label"><strong>Solo Regionali</strong></label>
            <input type="checkbox" class="form-check-input d-block" asp-for="Form.SoloRegionali" />
        </div>
        <div class="col-md-2 mb-3">
            <label for="Form_SoloDiretti" class="form-label"><strong>Diretti</strong></label>
            <input type="checkbox" class="form-check-input d-block" asp-for="Form.SoloDiretti" />
        </div>
        <div class="col-md-4 mb-3">
            <label for="Form_PrezzoMassimo" class="form-label"><strong>Prezzo massimo</strong></label>
            <input type="number" step="0.01" min="0" class="form-control" asp-for="Form.PrezzoMassimo" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Ricerca</button>
</form>

@if (Model.Messaggio is not null)
{
    <div class="stato text-center pt-3">
        <strong>@Model.Messaggio</strong>
    </div>
}

@if (Model.Soluzioni.Count > 0)
{
    <div class="table-responsive mt-3">
        <table class="table table-striped table-bordered table-hover">
            <thead class="StickyHeader">
                <tr>
                    <th>Stazione partenza</th>
                    <th>Stazione arrivo</th>
                    <th>Data partenza</th>
                    <th>Data arrivo</th>
                    <th>Prezzo</th>
                    <th>Durata</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Soluzioni.Count; i++)
                {
                    var s = Model.Soluzioni[i];
                    <tr>
                        <td>@s.solution?.origin</td>
                        <td>@s.solution?.destination</td>
                        <td>@(s.solution is { } sol ? Orario(sol.departureTime) : "-")</td>
                        <td>@(s.solution is { } sol2 ? Orario(sol2.arrivalTime) : "-")</td>
                        <td>@Prezzo(s.solution?.price)</td>
                        <td>@s.solution?.duration</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalDettaglio-@i">
                                Dettagli
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @for (var i = 0; i < Model.Soluzioni.Count; i++)
    {
        var s = Model.Soluzioni[i];
        <div class="modal fade" id="modalDettaglio-@i" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Dettagli soluzione</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                    </div>
                    <div class="modal-body">
                        <h6>Treni della soluzione</h6>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="width: 145px;">Treno</th>
                                        <th>Partenza</th>
                                        <th>Orario</th>
                                        <th>Arrivo</th>
                                        <th>Orario</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var riepilogo in griglia.summaries ?? [])
                                        {
                                            <tr>
                                                <td>@riepilogo.name</td>
                                                <td>@riepilogo.departureLocationName</td>
                                                <td>@Orario(riepilogo.departureTime)</td>
                                                <td>@riepilogo.arrivalLocationName</td>
                                                <td>@Orario(riepilogo.arrivalTime)</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <h6 class="mt-3">Offerte disponibili</h6>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="min-width: 90px;">Nome</th>
                                        <th style="min-width: 90px;">Offerta</th>
                                        <th style="min-width: 90px;">Prezzo</th>
                                        <th style="min-width: 90px;">Disponibilità</th>
                                        <th style="min-width: 90px;">Descrizione</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var griglia in s.grids ?? [])
                                    {
                                        @foreach (var servizio in griglia.services ?? [])
                                        {
                                            @foreach (var offerta in servizio.offers ?? [])
                                            {
                                                @if (offerta.availableAmount > 0)
                                                {
                                                    <tr>
                                                        <td>@offerta.serviceName</td>
                                                        <td>@offerta.name</td>
                                                        <td>@Prezzo(offerta.price)</td>
                                                        <td>@offerta.availableAmount</td>
                                                        <td>@offerta.description</td>
                                                    </tr>
                                                }
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Indietro</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Autocomplete delle stazioni: la datalist si riempie via man mano che si scrive
        document.querySelectorAll('.inputStazioniDropdown').forEach(function (input) {
            input.addEventListener('input', async function () {
                var testo = input.value.trim();
                if (testo.length < 2) return;
                try {
                    var risposta = await fetch('./?handler=Stazioni&nome=' + encodeURIComponent(testo));
                    var nomi = await risposta.json();
                    var datalist = document.getElementById(input.getAttribute('list'));
                    datalist.innerHTML = '';
                    nomi.forEach(function (nome) {
                        var opzione = document.createElement('option');
                        opzione.value = nome;
                        datalist.appendChild(opzione);
                    });
                } catch (exc) {
                    // l'elenco resta quello che era
                }
            });
        });
    </script>
}